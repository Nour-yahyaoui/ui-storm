{
  "name": "bidi-kit",
  "version": "0.1.0",
  "description": "Right-to-left text that behaves: Arabic inside English, French inside Arabic, no bidi glitches.",
  "keywords": [
    "bidi",
    "rtl",
    "arabic",
    "i18n",
    "unicode",
    "text",
    "font",
    "isolation",
    "hebrew"
  ],
  "license": "MIT",
  "author": "Nour Yahyaoui",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nour-yahyaoui/ui-storm.git",
    "directory": "packages/bidi-kit"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bidi-kit": "./bin/bidi-kit.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "demo": "node scripts/serve.mjs",
    "prepublishOnly": "npm test && node scripts/sync-static.mjs --check",
    "test:only": "node --test tests/*.test.mjs",
    "pack:check": "npm run build && node scripts/check-tarball.mjs",
    "static:sync": "npm run build && node scripts/sync-static.mjs",
    "static:check": "npm run build && node scripts/sync-static.mjs --check"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "unpkg": "./dist/bidi-kit.global.js",
  "jsdelivr": "./dist/bidi-kit.global.js"
}
